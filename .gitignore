# Dependências
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
.output/
build/
out/

# Entry temporario que o slidev escreve na raiz da aula durante o build.
# Ele mesmo apaga no fim, mas sobra se o build for interrompido (Ctrl+C).
aulas/*/*/index.html

# Cache e temp
.cache/
.temp/
.vite/
*.local

# Estado local do Cloudflare Workers (D1 simulado, etc.)
.wrangler/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/settings.json
*.swp
*.swo

# Obsidian vault
.obsidian/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / credenciais locais — nunca commitar, só .env.example
.env
.env.*
!.env.example
!*/.env.example

# Sub-repos com repositórios GitHub próprios
# (gerencie cada um separadamente)
slidev-theme-neural/
senac-planning-ai-tech/'    '
