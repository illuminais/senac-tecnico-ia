{
  // tsconfig mínimo só para type-check manual/ad-hoc (ex.: `tsc --noEmit`).
  // O Worker NÃO tem package.json (constituição §3) — este arquivo não é
  // consumido por nenhum build real; `wrangler deploy`/`--dry-run` (esbuild)
  // é a validação que de fato roda em CI/deploy e não faz checagem de tipos.
  //
  // `@cloudflare/workers-types` (tipos de D1Database/ExecutionContext/etc.)
  // não está instalado em lugar nenhum do monorepo — para rodar este
  // tsconfig localmente, instale-o num diretório à parte (nunca como
  // dependência do Worker) e aponte `typeRoots`/`NODE_PATH` para lá, ex.:
  //   npm install --no-save --prefix /tmp/wtypes @cloudflare/workers-types
  //   tsc --noEmit -p platform/worker/tsconfig.json \
  //     --typeRoots /tmp/wtypes/node_modules/@types,/tmp/wtypes/node_modules
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
