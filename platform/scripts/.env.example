# Copie para .env (mesma pasta) e preencha com seu usuário/senha de admin.
# Usado pelos scripts seed-*.mjs pra logar sozinho em POST /api/auth/login
# e pegar o JWT, sem precisar colar --token toda vez.
#
# Nunca commitar o .env real — já está no .gitignore raiz.
#
# Uso:
#   node --env-file=platform/scripts/.env platform/scripts/seed-indicadores.mjs --post <WORKER_URL>

ADMIN_USERNAME=
ADMIN_PASSWORD=
